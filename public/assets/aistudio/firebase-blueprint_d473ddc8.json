{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Registered member/donor of Al-Furqaan Quran Memorization Center",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Full name of the member",
          "maxLength": 120
        },
        "phoneNumber": {
          "type": "string",
          "description": "Ethiopian or international phone number",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "description": "Email address of the member",
          "maxLength": 100
        },
        "halqa": {
          "type": "string",
          "description": "Quran study group or halqa name",
          "maxLength": 60
        },
        "memberId": {
          "type": "string",
          "description": "Assigned unique member code, e.g. ALF-001",
          "maxLength": 30
        },
        "monthlyPledgeETB": {
          "type": "number",
          "description": "Pledged monthly contribution in Ethiopian Birr"
        },
        "status": {
          "type": "string",
          "description": "Membership status",
          "enum": ["active", "inactive", "suspended"]
        },
        "city": {
          "type": "string",
          "description": "City or residential location",
          "maxLength": 80
        },
        "createdBy": {
          "type": "string",
          "description": "UID of admin who created member",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["fullName", "phoneNumber", "memberId", "monthlyPledgeETB", "status", "createdBy"]
    },
    "Contribution": {
      "title": "Contribution",
      "description": "Monthly contribution / donation payment record",
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "description": "Firestore document ID or member code of the member",
          "maxLength": 64
        },
        "memberName": {
          "type": "string",
          "description": "Full name of member at time of contribution",
          "maxLength": 120
        },
        "receiptNumber": {
          "type": "string",
          "description": "Unique digital receipt serial number e.g. ALF-REC-2019-001",
          "maxLength": 40
        },
        "amountETB": {
          "type": "number",
          "description": "Amount paid in Ethiopian Birr"
        },
        "ethiopianMonth": {
          "type": "string",
          "description": "Ethiopian calendar month for which contribution is paid",
          "maxLength": 30
        },
        "ethiopianYear": {
          "type": "number",
          "description": "Ethiopian calendar year e.g. 2019"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment channel used",
          "enum": ["cbe", "telebirr", "awash", "cbe_birr", "cash", "bank_transfer", "other"]
        },
        "transactionReference": {
          "type": "string",
          "description": "Bank/Telebirr transaction slip or reference code",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or dua prayer intention",
          "maxLength": 300
        },
        "recordedBy": {
          "type": "string",
          "description": "UID of admin/cashier who recorded contribution",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "description": "Verification status of contribution",
          "enum": ["completed", "verified", "pending", "voided"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of record"
        }
      },
      "required": ["memberId", "memberName", "receiptNumber", "amountETB", "ethiopianMonth", "ethiopianYear", "paymentMethod", "recordedBy", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense of Al-Furqaan Quran Center",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Brief description of the expense",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Category of center expense",
          "enum": ["ustaz_allowance", "quran_books", "utilities", "maintenance", "charity_iftaar", "administrative", "other"]
        },
        "amountETB": {
          "type": "number",
          "description": "Amount spent in ETB"
        },
        "ethiopianDate": {
          "type": "string",
          "description": "Ethiopian calendar date of expenditure",
          "maxLength": 40
        },
        "paidTo": {
          "type": "string",
          "description": "Recipient or vendor",
          "maxLength": 100
        },
        "recordedBy": {
          "type": "string",
          "description": "UID of admin who entered expense",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["title", "category", "amountETB", "recordedBy"]
    },
    "CenterSetting": {
      "title": "CenterSetting",
      "description": "Configuration and contact info for Al-Furqaan Quran Center",
      "type": "object",
      "properties": {
        "centerName": {
          "type": "string",
          "description": "Official name of the Quran Hifz center",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Official contact phone number",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "description": "Official contact email",
          "maxLength": 100
        },
        "bankAccountDetails": {
          "type": "string",
          "description": "Official bank account and Telebirr merchant details",
          "maxLength": 500
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of admin who updated settings",
          "maxLength": 128
        }
      },
      "required": ["centerName"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Collection of all registered Al-Furqaan members and donors"
    },
    "/contributions/{contributionId}": {
      "schema": "Contribution",
      "description": "Collection of all contribution and payment transactions"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of operational expenses"
    },
    "/settings/{settingId}": {
      "schema": "CenterSetting",
      "description": "Al-Furqaan center global settings and bank details"
    }
  }
}
